pipeline {
    agent {
        label 'ci-agent'
    }

    stages {
        stage('Verify Image Tag') {
            steps {
                echo "Received IMAGE_TAG: ${params.IMAGE_TAG}"
                echo "Image to deploy: ghcr.io/namle1602/devops-flask-app:${params.IMAGE_TAG}"
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-deploy-key',
                    url: 'git@github.com:namle1602/devops-project.git'
            }
        }

        stage('Verify Kubernetes Connection') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        kubectl get pods -n devops-project
                        kubectl auth can-i create deployments \
                            -n devops-project
                    '''
                }
            }
        }

        // ===== STAGE MỚI: DEPLOY TO KUBERNETES =====
        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        IMAGE="ghcr.io/namle1602/devops-flask-app:${IMAGE_TAG}"

                        echo "Applying Kubernetes manifests..."
                        kubectl apply -f k8s/deployment.yaml \
                                      -f k8s/service.yaml \
                                      -n devops-project

                        echo "Updating Deployment image to ${IMAGE}..."
                        kubectl set image deployment/flask-deployment \
                            flask-app="${IMAGE}" \
                            -n devops-project

                        echo "Waiting for rolling update..."
                        kubectl rollout status deployment/flask-deployment \
                            -n devops-project \
                            --timeout=180s

                        echo "Deployment status:"
                        kubectl get deployments,pods,services \
                            -n devops-project
                    '''
                }
            }
        }
        // ===== KẾT THÚC STAGE MỚI =====

    }
}
