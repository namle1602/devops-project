
pipeline {
    agent {
        label 'ci-agent'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'GHCR image tag received from CI'
        )
    }

    environment {
        IMAGE_REPO = 'ghcr.io/namle1602/devops-flask-app'
        STAGING_NS = 'devops-staging'
        PRODUCTION_NS = 'devops-project'
        STAGING_DEPLOY_STARTED = 'false'
    }

    stages {

        stage('Verify Image Tag') {
            steps {
                script {
                    if (!(params.IMAGE_TAG ==~ /^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$/)) {
                        error('Invalid IMAGE_TAG')
                    }

env.DEPLOY_IMAGE =
    "${env.IMAGE_REPO}:${params.IMAGE_TAG}"

def safeJobName = env.JOB_NAME
    .toLowerCase()
    .replaceAll(/[^a-z0-9-]/, '-')
    .replaceAll(/-+/, '-')
    .replaceAll(/^-|-$/, '')

env.STAGING_RELEASE_ID =
    "${safeJobName}-${env.BUILD_NUMBER}"

echo "Image to deploy: ${env.DEPLOY_IMAGE}"
echo "Staging Release ID: ${env.STAGING_RELEASE_ID}"

                }
            }
        }

        stage('Checkout') {
            steps {
                git branch: (env.DEPLOY_BRANCH ?: 'main'),
                    credentialsId: 'github-deploy-key',
                    url: 'git@github.com:namle1602/devops-project.git'
            }
        }

        stage('Verify Kubernetes Connection') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'azure-k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Production ==="
                        kubectl get deployments,pods,services \
                            -n "${PRODUCTION_NS}"

                        echo "=== Staging ==="
                        kubectl get deployments,pods,services \
                            -n "${STAGING_NS}"

                        echo "=== Checking permissions ==="

                        for NS in "${STAGING_NS}" "${PRODUCTION_NS}"; do
                            for RESOURCE in deployments.apps services; do
                                for VERB in get create patch; do
                                    RESULT=$(kubectl auth can-i \
                                        "${VERB}" "${RESOURCE}" \
                                        -n "${NS}")

                                    if [ "${RESULT}" != "yes" ]; then
                                        echo "Permission denied: ${VERB} ${RESOURCE} in ${NS}"
                                        exit 1
                                    fi
                                done
                            done
                        done

                        echo "Kubernetes connection verified!"
                    '''
                }
            }
        }

stage('Staging Release') {
    stages {
        stage('Deploy to Staging') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'azure-k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Deploying to Staging ==="
                        echo "Image: ${DEPLOY_IMAGE}"

                        echo "=== Saving previous Staging state ==="

kubectl get deployment flask-deployment \
    -n "${STAGING_NS}" \
    -o jsonpath='{.spec.template.spec.containers[0].image}' \
    > staging-previous-image.txt

kubectl get deployment flask-deployment \
    -n "${STAGING_NS}" \
    -o jsonpath='{.spec.template}' \
    > staging-previous-template.json

test -s staging-previous-image.txt
test -s staging-previous-template.json

python3 -m json.tool staging-previous-template.json > /dev/null

echo "Previous Staging image: $(cat staging-previous-image.txt)"
echo "Previous Staging template saved successfully"
                    '''


sh '''
    set -eu

    echo "=== Applying Staging resources ==="

    kubectl apply \
        -f k8s/staging/service.yaml \
        -n "${STAGING_NS}"

sed \
    -e "s|${IMAGE_REPO}:latest|${DEPLOY_IMAGE}|g" \
    -e "s|IMAGE_TAG_PLACEHOLDER|${IMAGE_TAG}|g" \
    -e "s|RELEASE_ID_PLACEHOLDER|${STAGING_RELEASE_ID}|g" \
    k8s/staging/deployment.yaml \
    > staging-deployment-rendered.yaml

    test -s staging-deployment-rendered.yaml

    if grep -q 'RELEASE_ID_PLACEHOLDER' staging-deployment-rendered.yaml; then
    echo "ERROR: Staging Release ID placeholder was not replaced"
    exit 1
fi

    echo "Staging Deployment manifest rendered successfully"
'''

script {
    env.STAGING_DEPLOY_STARTED = 'true'
    echo 'Staging Deployment apply starting; rollback protection enabled'
}

sh '''
    set -eu

    echo "=== Applying Staging Deployment ==="

    kubectl apply \
        -f staging-deployment-rendered.yaml \
        -n "${STAGING_NS}"

    kubectl rollout status \
        deployment/flask-deployment \
        -n "${STAGING_NS}" \
        --timeout=180s

    DEPLOYED_IMAGE=$(kubectl get deployment flask-deployment \
        -n "${STAGING_NS}" \
        -o jsonpath='{.spec.template.spec.containers[0].image}')

    if [ "${DEPLOYED_IMAGE}" != "${DEPLOY_IMAGE}" ]; then
        echo "ERROR: Staging image mismatch"
        exit 1
    fi

    echo "Staging image verified: ${DEPLOYED_IMAGE}"
'''
                }
            }
        }

        stage('Staging Smoke Test') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'azure-k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Staging Smoke Test ==="

                        POD=$(kubectl get pods -n "${STAGING_NS}" \
    -l app=flask-app \
    --field-selector=status.phase=Running \
    -o jsonpath='{.items[0].metadata.name}')

                        if [ -z "${POD}" ]; then
                            echo "ERROR: No Staging Pod found"
                            exit 1
                        fi

                        kubectl exec "${POD}" \
                            -n "${STAGING_NS}" \
                            -- python -c '
import urllib.request
import json

url = "http://flask-service.devops-staging.svc.cluster.local/health"

with urllib.request.urlopen(url, timeout=15) as response:
    status = response.status
    body = json.loads(response.read().decode())

print("HTTP Status:", status)
print("Response:", body)

if status != 200 or body.get("status") != "healthy":
    raise SystemExit("Staging Smoke Test FAILED")

print("Staging Smoke Test PASSED")
'
                    '''
                }
            }
        }
    }

            post {
                unsuccessful {
                    script {
                        if (env.STAGING_DEPLOY_STARTED == 'true') {
                            echo 'Staging release failed. Starting automatic rollback.'

                            withCredentials([
                                file(
                                    credentialsId: 'azure-k3s-jenkins-kubeconfig',
                                    variable: 'KUBECONFIG'
                                )
                            ]) {
                                sh '''
                                    set -eu

                                    echo "=== Rolling back Staging ==="

                                    test -s staging-previous-image.txt
                                    test -s staging-previous-template.json


echo "=== Checking Staging image before rollback ==="

EXPECTED_IMAGE=$(cat staging-previous-image.txt)

CURRENT_IMAGE=$(kubectl get deployment flask-deployment \
    -n "${STAGING_NS}" \
    -o jsonpath='{.spec.template.spec.containers[0].image}')

echo "Previous image: ${EXPECTED_IMAGE}"
echo "Pipeline image: ${DEPLOY_IMAGE}"
echo "Current image: ${CURRENT_IMAGE}"

if [ "${CURRENT_IMAGE}" != "${DEPLOY_IMAGE}" ] &&
   [ "${CURRENT_IMAGE}" != "${EXPECTED_IMAGE}" ]; then
    echo "ERROR: Staging image changed outside this deployment."
    echo "Automatic rollback stopped to avoid overwriting another release."
    exit 1
fi

echo "=== Capturing current Staging Pod template ==="

kubectl get deployment flask-deployment \
    -n "${STAGING_NS}" \
    -o jsonpath='{.spec.template}' \
    > staging-current-template.json

test -s staging-current-template.json
python3 -m json.tool staging-current-template.json > /dev/null


echo "=== Checking Staging Release ID ==="

CURRENT_RELEASE_ID=$(python3 - <<'PY'
import json

with open('staging-current-template.json', encoding='utf-8') as f:
    template = json.load(f)

annotations = template.get('metadata', {}).get('annotations', {})
print(annotations.get('devops.example.com/release-id', ''))
PY
)

echo "Expected Release ID: ${STAGING_RELEASE_ID}"
echo "Current Release ID: ${CURRENT_RELEASE_ID}"

if [ "${CURRENT_RELEASE_ID}" != "${STAGING_RELEASE_ID}" ]; then
    echo "ERROR: Staging release ownership mismatch."
    echo "Automatic rollback stopped to avoid overwriting another release."
    echo "Deployment may be unchanged; verify its status manually."
    exit 1
fi

python3 - <<'PY'
import json

with open('staging-previous-template.json', encoding='utf-8') as f:
    previous_template = json.load(f)

with open('staging-current-template.json', encoding='utf-8') as f:
    current_template = json.load(f)

patch = [
    {
        "op": "test",
        "path": "/spec/template",
        "value": current_template
    },
    {
        "op": "replace",
        "path": "/spec/template",
        "value": previous_template
    }
]

with open('staging-rollback-patch.json', 'w', encoding='utf-8') as f:
    json.dump(patch, f)
PY

                                    kubectl patch deployment flask-deployment \
                                        -n "${STAGING_NS}" \
                                        --type=json \
                                        --patch-file staging-rollback-patch.json

                                    kubectl rollout status deployment/flask-deployment \
                                        -n "${STAGING_NS}" \
                                        --timeout=180s

                                    EXPECTED_IMAGE=$(cat staging-previous-image.txt)

                                    ACTUAL_IMAGE=$(kubectl get deployment flask-deployment \
                                        -n "${STAGING_NS}" \
                                        -o jsonpath='{.spec.template.spec.containers[0].image}')

                                    if [ "${ACTUAL_IMAGE}" != "${EXPECTED_IMAGE}" ]; then
                                        echo "ERROR: Staging rollback image mismatch"
                                        exit 1
                                    fi

                                    echo "=== Verifying Staging health after rollback ==="

kubectl exec deployment/flask-deployment \
    -n "${STAGING_NS}" \
    -- python3 -c '
import json
import urllib.request

url = "http://flask-service.devops-staging.svc.cluster.local/health"

with urllib.request.urlopen(url, timeout=10) as response:
    status_code = response.status
    data = json.load(response)

assert status_code == 200, f"Unexpected HTTP status: {status_code}"
assert data.get("status") == "healthy", f"Unexpected health response: {data}"

print("Staging rollback health check PASSED")
'

                                    echo "Staging rollback completed: ${ACTUAL_IMAGE}"
                                '''
                            }
                        } else {
                            echo 'Staging deployment was not started. Skipping rollback.'
                        }
                    }
                }
            }
         }

        stage('Approve Production Deployment') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input(
                        message: "Staging passed. Deploy image ${env.DEPLOY_IMAGE} to Production?",
                        ok: 'Deploy to Production'
                    )
                }
            }
        }

        stage('Production Release') {
            stages {
                stage('Deploy to Production') {
                    steps {
                    withCredentials([
                    file(
                        credentialsId: 'azure-k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    script {
                        sh '''
                            set -eu

                            echo "=== Saving current Production image ==="

                            kubectl get deployment flask-deployment \
                                -n "${PRODUCTION_NS}" \
                                -o jsonpath='{.spec.template.spec.containers[0].image}' \
                                > production-previous-image.txt

                            echo "Previous image:"
                            cat production-previous-image.txt

                            echo "=== Saving current Production Pod template ==="

                            kubectl get deployment flask-deployment \
                                -n "${PRODUCTION_NS}" \
                                -o jsonpath='{.spec.template}' \
                                > production-previous-template.json

                            test -s production-previous-template.json

                            echo "Previous Production Pod template saved."
                        '''

                        env.PRODUCTION_DEPLOY_STARTED = 'true'

                            sh '''
                                set -eu

                                echo "=== Deploying to Production ==="

                                kubectl apply \
                                    -f k8s/service.yaml \
                                    -n "${PRODUCTION_NS}"

                                sed \
    -e "s|${IMAGE_REPO}:latest|${DEPLOY_IMAGE}|g" \
    -e "s|IMAGE_TAG_PLACEHOLDER|${IMAGE_TAG}|g" \
    k8s/deployment.yaml \
    > production-deployment-rendered.yaml

                                kubectl apply \
                                    -f production-deployment-rendered.yaml \
                                    -n "${PRODUCTION_NS}"

                                kubectl rollout status \
                                    deployment/flask-deployment \
                                    -n "${PRODUCTION_NS}" \
                                    --timeout=180s

                                DEPLOYED_IMAGE=$(kubectl get deployment flask-deployment \
                                    -n "${PRODUCTION_NS}" \
                                    -o jsonpath='{.spec.template.spec.containers[0].image}')

                                if [ "${DEPLOYED_IMAGE}" != "${DEPLOY_IMAGE}" ]; then
                                    echo "ERROR: Production image mismatch"
                                    exit 1
                                fi

                                echo "Production image verified: ${DEPLOYED_IMAGE}"
                            '''
                        }
                    }
                }
            }

        stage('Deploy Istio Configuration') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'azure-k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "=== Validating Istio ==="

                        kubectl apply --dry-run=server \
                            -f istio/flask-gateway.yaml \
                            -n "${PRODUCTION_NS}"

                        kubectl apply --dry-run=server \
                            -f istio/flask-virtualservice.yaml \
                            -n "${PRODUCTION_NS}"

                        echo "=== Applying Istio ==="

                        kubectl apply \
                            -f istio/flask-gateway.yaml \
                            -n "${PRODUCTION_NS}"

                        kubectl apply \
                            -f istio/flask-virtualservice.yaml \
                            -n "${PRODUCTION_NS}"

                        kubectl get gateways.networking.istio.io \
                            -n "${PRODUCTION_NS}"

                        kubectl get virtualservices.networking.istio.io \
                            -n "${PRODUCTION_NS}"

                        echo "Istio configuration deployed successfully!"
                    '''
                }
            }
        }

        stage('Production Smoke Test') {
    steps {
        withCredentials([
            string(
                credentialsId: 'production-health-url',
                variable: 'PRODUCTION_HEALTH_URL'
            )
        ]) {
            sh '''
                set -eu

                echo "=== Production Smoke Test ==="

                RESPONSE=$(curl --fail --silent --show-error \
                    --max-time 15 \
                    "${PRODUCTION_HEALTH_URL}")

                echo "Response: ${RESPONSE}"

                if [ "${RESPONSE}" != '{"status":"healthy"}' ]; then
                    echo "ERROR: Production health response is invalid"
                    exit 1
                fi

                echo "Production Smoke Test PASSED"
            '''
        }
    }
}
    } // Kết thúc stages của Production Release
    post {
        failure {
            script {
                if (env.PRODUCTION_DEPLOY_STARTED == 'true') {
                    echo 'Production Release FAILED. Attempting image rollback.'

                    withCredentials([
    file(
        credentialsId: 'azure-k3s-jenkins-kubeconfig',
        variable: 'KUBECONFIG'
    ),
    string(
        credentialsId: 'production-health-url',
        variable: 'PRODUCTION_HEALTH_URL'
    )
]) {
                        sh '''
                            set -eu

                            echo "=== Rolling back Production image ==="

                            PREVIOUS_IMAGE=$(cat production-previous-image.txt)

                            if [ -z "${PREVIOUS_IMAGE}" ]; then
                                echo "ERROR: Previous image is empty"
                                exit 1
                            fi

                                                        echo "=== Restoring previous Production Pod template ==="

                            test -s production-previous-template.json

python3 - <<'PY'
import json

with open("production-previous-template.json", encoding="utf-8") as f:
    template = json.load(f)

patch = [
    {
        "op": "replace",
        "path": "/spec/template",
        "value": template
    }
]

with open("production-rollback-patch.json", "w", encoding="utf-8") as f:
    json.dump(patch, f)
PY

                            kubectl patch deployment flask-deployment \
                                -n "${PRODUCTION_NS}" \
                                --type=json \
                                --patch-file production-rollback-patch.json

                            kubectl rollout status \
                                deployment/flask-deployment \
                                -n "${PRODUCTION_NS}" \
                                --timeout=180s

                            CURRENT_IMAGE=$(kubectl get deployment flask-deployment \
                                -n "${PRODUCTION_NS}" \
                                -o jsonpath='{.spec.template.spec.containers[0].image}')

                            if [ "${CURRENT_IMAGE}" != "${PREVIOUS_IMAGE}" ]; then
                                echo "ERROR: Rollback image mismatch"
                                exit 1
                            fi

                            echo "=== Verifying Production health ==="

                            RESPONSE=$(curl --fail --silent --show-error \
    --max-time 15 \
    "${PRODUCTION_HEALTH_URL}")

                            echo "Response: ${RESPONSE}"

                            if [ "${RESPONSE}" != '{"status":"healthy"}' ]; then
                                echo "ERROR: Production health check failed after rollback"
                                exit 1
                            fi

                            echo "Production image rollback verified successfully!"
                        '''
                    }
                } else {
                    echo 'Production deployment was not started. Skipping rollback.'
                }
            }
        }
    }
        }// Kết thúc Production Release
    } // Kết thúc stages của Pipeline
    post {
        success {
            echo "CD Pipeline SUCCESS: ${env.DEPLOY_IMAGE}"
        }

        failure {
            echo "CD Pipeline FAILED. Review logs and rollback status."
        }

        aborted {
            echo "CD Pipeline ABORTED."
        }
    }
}
