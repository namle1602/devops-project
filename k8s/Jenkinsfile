pipeline {
    agent {
        label 'ci-agent'
    }

    stages {
        stage('Verify Image Tag') {
            steps {
                echo "Received IMAGE_TAG: ${params.IMAGE_TAG}"
                echo "Image to deploy: ghcr.io/namle1602/devops-flask-app:${params.IMAGE_TAG}"
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-deploy-key',
                    url: 'git@github.com:namle1602/devops-project.git'
            }
        }

        stage('Verify Kubernetes Connection') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-jenkins-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        kubectl get pods -n devops-project
                        kubectl auth can-i create deployments \
                            -n devops-project
                    '''
                }
            }
        }

        
stage('Deploy to Kubernetes') {
    steps {
        withCredentials([
            file(
                credentialsId: 'k3s-jenkins-kubeconfig',
                variable: 'KUBECONFIG'
            )
        ]) {
            sh '''
                set -eu

                IMAGE="ghcr.io/namle1602/devops-flask-app:${IMAGE_TAG}"

                echo "Validating image tag..."
                case "${IMAGE_TAG}" in
                    ""|*[!a-zA-Z0-9_.-]*)
                        echo "ERROR: Invalid IMAGE_TAG"
                        exit 1
                        ;;
                esac

                echo "Deploying image: ${IMAGE}"

                echo "Applying Service..."
                kubectl apply -f k8s/service.yaml \
                    -n devops-project

                echo "Rendering Deployment with the requested image..."
                sed "s|ghcr.io/namle1602/devops-flask-app:latest|${IMAGE}|g" \
                    k8s/deployment.yaml > deployment-rendered.yaml

                echo "Applying Deployment..."
                kubectl apply -f deployment-rendered.yaml \
                    -n devops-project

                echo "Waiting for rolling update..."
                kubectl rollout status deployment/flask-deployment \
                    -n devops-project \
                    --timeout=180s

                echo "Verifying deployed image..."
                DEPLOYED_IMAGE=$(kubectl get deployment flask-deployment \
                    -n devops-project \
                    -o jsonpath='{.spec.template.spec.containers[0].image}')

                if [ "${DEPLOYED_IMAGE}" != "${IMAGE}" ]; then
                    echo "ERROR: Deployed image does not match requested image"
                    exit 1
                fi

                echo "Deployment image verified: ${DEPLOYED_IMAGE}"

                kubectl get deployments,pods,services \
                    -n devops-project
            '''
        }
    }
}


    }
}
